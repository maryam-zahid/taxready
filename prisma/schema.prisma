generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PracticeType {
  INDEPENDENT_TAX_PROFESSIONAL
  TAX_ACCOUNTING_FIRM
  OTHER
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum IndividualTaxpayerType {
  SALARIED_INDIVIDUAL
  FREELANCER_PROFESSIONAL
  SOLE_PROPRIETOR
  OTHER_INDIVIDUAL
}

enum BusinessEntityType {
  PARTNERSHIP_AOP
  PRIVATE_LIMITED_COMPANY
  PUBLIC_LIMITED_COMPANY
  OTHER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum FilingHistoryStatus {
  NEW_FILER
  EXISTING_FILER
  PREVIOUS_RETURN_UNAVAILABLE
}

enum IncomeSourceType {
  SALARY_EMPLOYMENT
  FREELANCE_PROFESSIONAL
  BUSINESS
  RENTAL_PROPERTY
  CAPITAL_GAINS
  INVESTMENT_PROFIT
  AGRICULTURAL
  FOREIGN
  OTHER
}

enum AssetType {
  BANK_ACCOUNT
  CASH_FINANCIAL_ASSETS
  IMMOVABLE_PROPERTY
  VEHICLE
  INVESTMENTS_SECURITIES
  BUSINESS_ASSETS
  FOREIGN_ASSETS
  OTHER_ASSETS
}

enum TaxEvidenceType {
  EMPLOYER_WITHHOLDING
  BANK_WITHHOLDING
  PROPERTY_TAX_WITHHOLDING
  VEHICLE_TAX
  BUSINESS_CUSTOMER_WITHHOLDING
  ADVANCE_TAX_PAYMENT
  OTHER_TAX_DEDUCTED
}

enum RequirementCategory {
  PRIOR_FILING
  INCOME
  BANKING
  ASSETS
  LIABILITIES
  TAX_WITHHOLDING
  OTHER
}

enum RequirementResponseType {
  DOCUMENT
  INFORMATION
  DOCUMENT_OR_INFORMATION
}

enum RequirementStatus {
  PENDING
  REQUESTED
  SUBMITTED
  NEEDS_REVIEW
  COMPLETED
  NOT_AVAILABLE
  NOT_APPLICABLE
  WAIVED
}

enum RequirementSource {
  PROFILE_RULE
  MANUAL
}

enum ClientRequestStatus {
  DRAFT
  SENT
  VIEWED
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum ClientResponseStatus {
  DRAFT
  SUBMITTED
}

enum ClientPortalAccessStatus {
  NOT_INVITED
  INVITED
  ACTIVE
  DISABLED
}

enum ClientInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DocumentStatus {
  UPLOADED
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum DocumentSource {
  CLIENT_PORTAL
  ADMIN
}

enum ExceptionStatus {
  OPEN
  WAITING_CLIENT
  UNDER_REVIEW
  RESOLVED
  WAIVED
}

enum ExceptionSeverity {
  INFO
  WARNING
  BLOCKING
}

enum ExceptionSource {
  DOCUMENT_REVIEW
  VALIDATION
  RECONCILIATION
  MANUAL
}

enum DocumentValidationStatus {
  PENDING
  PASSED
  NEEDS_REVIEW
}

enum ValidationCheckStatus {
  PASSED
  FAILED
  NOT_CHECKED
}

enum DocumentExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

enum ExtractedFieldType {
  TEXT
  NUMBER
  MONEY
  DATE
  TAX_YEAR
}

enum TaxReadinessStatus {
  IN_PROGRESS
  BLOCKED
  READY_FOR_REVIEW
  TAX_READY
}

enum NotificationAudience {
  ADMIN
  CLIENT
}

enum NotificationType {
  INFO
  ACTION_REQUIRED
  WARNING
  SUCCESS
}

enum AuditAction {
  CLIENT_CREATED
  REQUEST_SENT
  INFORMATION_SUBMITTED
  DOCUMENT_SUBMITTED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_NEEDS_REVIEW
  EXCEPTION_RESOLVED
  CLIENT_MARKED_TAX_READY
}

model User {
  id                      String               @id
  name                    String
  email                   String
  emailVerified           Boolean              @default(false)
  image                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  sessions                Session[]
  accounts                Account[]
  adminProfile            AdminProfile?
  clientPortalAccess      ClientPortalAccess?
  organizationMemberships OrganizationMember[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  jobTitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_profile")
}

model Organization {
  id            String       @id @default(cuid())
  name          String
  practiceType  PracticeType
  businessEmail String?
  businessPhone String?
  ntn           String?
  country       String       @default("Pakistan")
  city          String?
  address       String?
  website       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  members              OrganizationMember[]
  clients              Client[]
  documents            Document[]
  complianceExceptions ComplianceException[]

  @@map("organization")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_member")
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  type           ClientType
  status         ClientStatus @default(ACTIVE)

  firstName     String?
  lastName      String?
  businessName  String?
  contactPerson String?

  email String
  phone String?
  ntn   String?

  taxpayerType     IndividualTaxpayerType?
  entityType       BusinessEntityType?
  occupation       String?
  businessActivity String?

  taxYear              Int
  preparationDeadline  DateTime?
  sendPortalInvitation Boolean            @default(true)
  taxReadinessStatus   TaxReadinessStatus @default(IN_PROGRESS)
  taxReadyAt           DateTime?
  taxReadyByUserId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxProfile           ClientTaxProfile?
  requirements         ClientRequirement[]
  requests             ClientRequest[]
  portalAccess         ClientPortalAccess?
  invitations          ClientInvitation[]
  documents            Document[]
  complianceExceptions ComplianceException[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([email])
  @@map("client")
}

model ClientTaxProfile {
  id       String @id @default(cuid())
  clientId String @unique

  filingHistoryStatus              FilingHistoryStatus
  previousTaxReturnAvailable       Boolean             @default(false)
  previousWealthStatementAvailable Boolean             @default(false)

  hasLiabilities       Boolean @default(false)
  hasMultipleEmployers Boolean @default(false)

  openingWealth     Decimal? @db.Decimal(18, 2)
  wealthAdditions   Decimal? @db.Decimal(18, 2)
  wealthReductions  Decimal? @db.Decimal(18, 2)
  closingWealth     Decimal? @db.Decimal(18, 2)

  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client           Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  incomeSources    ClientIncomeSource[]
  assetTypes       ClientAssetType[]
  taxEvidenceTypes ClientTaxEvidenceType[]

  @@index([clientId])
  @@map("client_tax_profile")
}
model ClientIncomeSource {
  id           String           @id @default(cuid())
  taxProfileId String
  type         IncomeSourceType

  declaredAmount Decimal? @db.Decimal(18, 2)

  taxProfile ClientTaxProfile @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)

  @@unique([taxProfileId, type])
  @@index([taxProfileId])
  @@map("client_income_source")
}

model ClientAssetType {
  id           String    @id @default(cuid())
  taxProfileId String
  type         AssetType

  taxProfile ClientTaxProfile @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)

  @@unique([taxProfileId, type])
  @@index([taxProfileId])
  @@map("client_asset_type")
}

model ClientTaxEvidenceType {
  id           String          @id @default(cuid())
  taxProfileId String
  type         TaxEvidenceType

  taxProfile ClientTaxProfile @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)

  @@unique([taxProfileId, type])
  @@index([taxProfileId])
  @@map("client_tax_evidence_type")
}

model RequirementDefinition {
  id           String                  @id @default(cuid())
  code         String                  @unique
  title        String
  description  String?
  category     RequirementCategory
  responseType RequirementResponseType
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  clientRequirements ClientRequirement[]

  @@index([category])
  @@index([active])
  @@map("requirement_definition")
}

model ClientRequirement {
  id                      String @id @default(cuid())
  clientId                String
  requirementDefinitionId String
  taxYear                 Int

  status RequirementStatus @default(PENDING)
  source RequirementSource @default(PROFILE_RULE)

  required Boolean @default(true)

  practitionerNote String?
  clientNote       String?

  generatedAt DateTime  @default(now())
  completedAt DateTime?
  waivedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client                Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requirementDefinition RequirementDefinition @relation(fields: [requirementDefinitionId], references: [id])
  requests              ClientRequest[]
  documents             Document[]
  complianceExceptions  ComplianceException[]

  @@unique([clientId, requirementDefinitionId, taxYear])
  @@index([clientId])
  @@index([clientId, taxYear])
  @@index([status])
  @@map("client_requirement")
}

model ClientRequest {
  id String @id @default(cuid())

  clientId            String
  clientRequirementId String

  status ClientRequestStatus @default(DRAFT)

  subject String
  message String?

  dueAt       DateTime?
  sentAt      DateTime?
  viewedAt    DateTime?
  submittedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  clientRequirement ClientRequirement @relation(fields: [clientRequirementId], references: [id], onDelete: Cascade)
  responses         ClientResponse[]
  documents         Document[]

  @@index([clientId])
  @@index([clientId, status])
  @@index([clientRequirementId])
  @@index([dueAt])
  @@map("client_request")
}

model ClientPortalAccess {
  id String @id @default(cuid())

  clientId String  @unique
  userId   String? @unique

  status ClientPortalAccessStatus @default(NOT_INVITED)

  invitedAt   DateTime?
  activatedAt DateTime?
  disabledAt  DateTime?
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("client_portal_access")
}

model ClientInvitation {
  id String @id @default(cuid())

  clientId String

  email     String
  tokenHash String @unique

  status ClientInvitationStatus @default(PENDING)

  expiresAt DateTime
  sentAt    DateTime @default(now())

  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, status])
  @@index([email])
  @@index([expiresAt])
  @@map("client_invitation")
}

model ClientResponse {
  id String @id @default(cuid())

  clientRequestId String

  status ClientResponseStatus @default(DRAFT)

  informationText String?

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientRequest ClientRequest @relation(fields: [clientRequestId], references: [id], onDelete: Cascade)

  @@index([clientRequestId])
  @@index([clientRequestId, status])
  @@map("client_response")
}

model Document {
  id                  String  @id @default(cuid())
  organizationId      String
  clientId            String
  clientRequestId     String?
  clientRequirementId String?

  fileName   String
  storageKey String @unique
  mimeType   String
  sizeBytes  Int
  sha256Hash String

  status DocumentStatus @default(UPLOADED)
  source DocumentSource @default(CLIENT_PORTAL)

  uploadedByUserId String
  uploadedAt       DateTime  @default(now())
  reviewedAt       DateTime?
  reviewNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientRequest     ClientRequest?     @relation(fields: [clientRequestId], references: [id], onDelete: SetNull)
  clientRequirement ClientRequirement? @relation(fields: [clientRequirementId], references: [id], onDelete: SetNull)

  complianceExceptions ComplianceException[]
  validation           DocumentValidation?
  extraction           DocumentExtraction?

  @@unique([clientId, sha256Hash])
  @@index([organizationId])
  @@index([clientId])
  @@index([clientRequestId])
  @@index([clientRequirementId])
  @@index([clientId, status])
  @@map("document")
}

model ComplianceException {
  id                  String  @id @default(cuid())
  organizationId      String
  clientId            String
  clientRequirementId String?
  documentId          String?

  title       String
  description String
  status      ExceptionStatus   @default(OPEN)
  severity    ExceptionSeverity @default(WARNING)
  source      ExceptionSource

  resolutionNote   String?
  createdByUserId  String?
  resolvedByUserId String?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientRequirement ClientRequirement? @relation(fields: [clientRequirementId], references: [id], onDelete: SetNull)
  document          Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
  @@index([clientRequirementId])
  @@index([documentId])
  @@index([organizationId, status])
  @@index([clientId, status])
  @@map("compliance_exception")
}

model DocumentValidation {
  id         String @id @default(cuid())
  documentId String @unique

  status DocumentValidationStatus @default(PENDING)

  fileTypeCheck    ValidationCheckStatus @default(NOT_CHECKED)
  fileSizeCheck    ValidationCheckStatus @default(NOT_CHECKED)
  requirementCheck ValidationCheckStatus @default(NOT_CHECKED)
  taxYearCheck     ValidationCheckStatus @default(NOT_CHECKED)

  expectedTaxYear Int?
  detectedTaxYear Int?

  summary     String?
  validatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("document_validation")
}

model DocumentExtraction {
  id         String                   @id @default(cuid())
  documentId String                   @unique
  status     DocumentExtractionStatus @default(PENDING)

  extractorVersion String?
  rawText          String?
  errorMessage     String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fields   ExtractedField[]

  @@index([status])
  @@map("document_extraction")
}

model ExtractedField {
  id           String             @id @default(cuid())
  extractionId String
  key          String
  label        String
  type         ExtractedFieldType

  textValue    String?
  numericValue Decimal? @db.Decimal(18, 2)

  sourceText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extraction DocumentExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@unique([extractionId, key])
  @@index([extractionId])
  @@map("extracted_field")
}

model Notification {
  id String @id @default(cuid())

  organizationId String
  clientId       String?
  userId         String?

  audience NotificationAudience
  type     NotificationType     @default(INFO)

  title   String
  message String
  href    String?

  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, audience])
  @@index([clientId, audience])
  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@map("notification")
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  clientId       String?
  userId         String?
  action         AuditAction
  description    String
  entityType     String?
  entityId       String?
  createdAt      DateTime    @default(now())

  @@index([organizationId])
  @@index([clientId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_log")
}
